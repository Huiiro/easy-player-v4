if(NOT CMAKE_OSX_ARCHITECTURES)
    if(CMAKE_HOST_SYSTEM_PROCESSOR STREQUAL "arm64")
        set(CMAKE_OSX_ARCHITECTURES arm64 CACHE STRING "Mac target architecture")
    else()
        set(CMAKE_OSX_ARCHITECTURES x86_64 CACHE STRING "Mac target architecture")
    endif()
endif()
if(CMAKE_OSX_ARCHITECTURES STREQUAL "arm64")
    set(AUDIO_DEPS_TRIPLET arm64-osx-audio)
elseif(CMAKE_OSX_ARCHITECTURES STREQUAL "x86_64")
    set(AUDIO_DEPS_TRIPLET x64-osx-audio)
else()
    message(FATAL_ERROR "Build arm64/x86_64 separately; a universal addon requires both dependency slices")
endif()
set(CMAKE_OSX_DEPLOYMENT_TARGET "12.0" CACHE STRING "Minimum supported macOS" FORCE)
get_filename_component(AUDIO_DEPS_CONFIG "${CMAKE_CURRENT_LIST_DIR}" ABSOLUTE)
get_filename_component(AUDIO_DEPS_ROOT "${AUDIO_DEPS_CONFIG}/../../../build/native-deps/installed/${AUDIO_DEPS_TRIPLET}" ABSOLUTE)
file(SHA256 "${AUDIO_DEPS_CONFIG}/ffmpeg-profile.cmake" PROFILE_SHA)
file(SHA256 "${AUDIO_DEPS_CONFIG}/vcpkg.json" MANIFEST_SHA)
file(SHA256 "${AUDIO_DEPS_CONFIG}/triplets/${AUDIO_DEPS_TRIPLET}.cmake" TRIPLET_SHA)
file(SHA256 "${AUDIO_DEPS_CONFIG}/sources.json" SOURCES_SHA)
file(SHA256 "${AUDIO_DEPS_CONFIG}/ffmpeg-profile-macos.cmake" MACOS_SHA)
string(SHA256 EXPECTED_PROFILE_SHA "${PROFILE_SHA}\n${MANIFEST_SHA}\n${TRIPLET_SHA}\n${SOURCES_SHA}\n${MACOS_SHA}")
set(PROFILE_STAMP "${AUDIO_DEPS_ROOT}/share/ffmpeg/easy-player-profile.sha256")
if(NOT EXISTS "${PROFILE_STAMP}")
    message(FATAL_ERROR "Run npm run prepare:native on this Mac first")
endif()
file(READ "${PROFILE_STAMP}" INSTALLED_PROFILE_SHA)
string(STRIP "${INSTALLED_PROFILE_SHA}" INSTALLED_PROFILE_SHA)
if(NOT INSTALLED_PROFILE_SHA STREQUAL EXPECTED_PROFILE_SHA)
    message(FATAL_ERROR "Mac audio dependency profile changed. Run npm run prepare:native")
endif()
list(PREPEND CMAKE_PREFIX_PATH "${AUDIO_DEPS_ROOT}")
foreach(VAR FFMPEG_INCLUDE_DIR AVCODEC_LIB AVFORMAT_LIB AVUTIL_LIB SWRESAMPLE_LIB
        SAMPLERATE_INCLUDE_DIR SAMPLERATE_LIB SOUNDTOUCH_INCLUDE_DIR SOUNDTOUCH_LIB)
    unset(${VAR} CACHE)
endforeach()
