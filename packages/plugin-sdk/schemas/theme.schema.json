{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Easy Player theme data (format 1, SDK 2.1)",
  "description": "Authoring hints; host additionally validates CSS support, resource signatures, slot references, texture byte counts and all archive bounds.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "colorMode",
    "accentColor",
    "headerBackground",
    "footerBackground",
    "chromeBorder",
    "background"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "colorMode": {
      "enum": ["light", "dark"]
    },
    "accentColor": {
      "$ref": "#/definitions/color"
    },
    "headerBackground": {
      "$ref": "#/definitions/color"
    },
    "footerBackground": {
      "$ref": "#/definitions/color"
    },
    "chromeBorder": {
      "$ref": "#/definitions/color"
    },
    "background": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[a-zA-Z0-9#().,% /+-]+$",
      "not": {
        "pattern": "(?:[uU][rR][lL]|[vV][aA][rR]|[eE][xX][pP][rR][eE][sS][sS][iI][oO][nN]|[iI][mM][aA][gG][eE]-[sS][eE][tT]|[pP][aA][iI][nN][tT])\\s*\\("
      }
    },
    "tokens": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^--(?:color|btn|scrollbar|app|ep|lrc|motion)-[a-z0-9-]+$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/cssValue"
      },
      "properties": {
        "--ep-glass-control-radius": {
          "$ref": "#/definitions/cssValue",
          "description": "输入框、选择器和颜色按钮圆角",
          "default": "10px"
        },
        "--ep-glass-button-radius": {
          "$ref": "#/definitions/cssValue",
          "description": "按钮圆角",
          "default": "999px"
        },
        "--ep-glass-dialog-radius": {
          "$ref": "#/definitions/cssValue",
          "description": "弹窗和抽屉圆角",
          "default": "22px"
        },
        "--ep-glass-floating-radius": {
          "$ref": "#/definitions/cssValue",
          "description": "菜单和浮层圆角",
          "default": "16px"
        },
        "--ep-glass-message-radius": {
          "$ref": "#/definitions/cssValue",
          "description": "消息通知圆角",
          "default": "16px"
        },
        "--ep-glass-control-bg": {
          "$ref": "#/definitions/cssValue",
          "description": "次要按钮和颜色按钮底色",
          "default": "color-mix(in srgb, var(--color-bg-l2) 28%, transparent)"
        },
        "--ep-glass-control-border": {
          "$ref": "#/definitions/cssValue",
          "description": "控件边框颜色",
          "default": "color-mix(in srgb, var(--color-text) 14%, transparent)"
        },
        "--ep-glass-control-highlight": {
          "$ref": "#/definitions/cssValue",
          "description": "控件和滑块表面高光",
          "default": "linear-gradient(135deg, rgb(255 255 255 / 14%), rgb(255 255 255 / 2%))"
        },
        "--ep-glass-control-shadow": {
          "$ref": "#/definitions/cssValue",
          "description": "控件内高光和阴影",
          "default": "inset 0 1px 0 rgb(255 255 255 / 14%), 0 2px 8px rgb(0 0 0 / 8%)"
        },
        "--ep-glass-input-bg": {
          "$ref": "#/definitions/cssValue",
          "description": "输入框底色",
          "default": "color-mix(in srgb, var(--color-bg-d) 8%, transparent)"
        },
        "--ep-glass-switch-inactive": {
          "$ref": "#/definitions/cssValue",
          "description": "开关关闭轨道颜色",
          "default": "color-mix(in srgb, var(--color-text) 18%, transparent)"
        },
        "--ep-glass-switch-thumb": {
          "$ref": "#/definitions/cssValue",
          "description": "开关滑块颜色",
          "default": "color-mix(in srgb, var(--color-white, #fff) 88%, transparent)"
        },
        "--ep-glass-track": {
          "$ref": "#/definitions/cssValue",
          "description": "滑块和进度条未播放轨道",
          "default": "color-mix(in srgb, var(--color-text) 22%, transparent)"
        },
        "--ep-glass-track-fill": {
          "$ref": "#/definitions/cssValue",
          "description": "滑块和进度条已播放轨道",
          "default": "var(--color-primary)"
        },
        "--ep-glass-thumb": {
          "$ref": "#/definitions/cssValue",
          "description": "滑块和原生进度条拇指颜色",
          "default": "color-mix(in srgb, var(--color-text) 88%, var(--color-primary))"
        },
        "--ep-glass-skeleton": {
          "$ref": "#/definitions/cssValue",
          "description": "骨架屏底色",
          "default": "color-mix(in srgb, var(--color-text) 10%, transparent)"
        },
        "--ep-glass-surface-border": {
          "$ref": "#/definitions/cssValue",
          "description": "独立玻璃面板边框颜色",
          "default": "color-mix(in srgb, var(--color-text) 10%, transparent)"
        },
        "--ep-glass-surface-shadow": {
          "$ref": "#/definitions/cssValue",
          "description": "独立面板阴影",
          "default": "0 8px 32px rgb(0 0 0 / 10%), inset 0 .5px 1.5px rgb(255 255 255 / 6%)"
        },
        "--ep-glass-chrome-tint": {
          "$ref": "#/definitions/cssValue",
          "description": "Header 和侧栏底色比例",
          "default": "4%"
        },
        "--ep-glass-footer-tint": {
          "$ref": "#/definitions/cssValue",
          "description": "Footer 底色比例",
          "default": "6%"
        },
        "--ep-glass-panel-tint": {
          "$ref": "#/definitions/cssValue",
          "description": "弹窗和抽屉底色比例",
          "default": "8%"
        },
        "--ep-glass-floating-tint": {
          "$ref": "#/definitions/cssValue",
          "description": "菜单、颜色面板和消息底色比例",
          "default": "12%"
        },
        "--ep-glass-floating-blur-radius": {
          "$ref": "#/definitions/cssValue",
          "description": "浮层高斯采样半径，0–200，显示像素；缺省跟随当前光学预设",
          "default": "60"
        },
        "--ep-backtop-size": {
          "$ref": "#/definitions/cssValue",
          "description": "回到顶部按钮宽高",
          "default": "36px"
        },
        "--ep-backtop-radius": {
          "$ref": "#/definitions/cssValue",
          "description": "回到顶部按钮圆角",
          "default": "999px"
        },
        "--ep-backtop-right": {
          "$ref": "#/definitions/cssValue",
          "description": "回到顶部按钮右侧间距",
          "default": "20px"
        },
        "--ep-backtop-bottom": {
          "$ref": "#/definitions/cssValue",
          "description": "通用回到顶部按钮底部间距；歌曲列表缺省跟随 Footer 避让",
          "default": "20px"
        },
        "--ep-tooltip-bg": {
          "$ref": "#/definitions/cssValue",
          "description": "提示层底色；玻璃开启时缺省跟随浮层染色",
          "default": "var(--color-bg-l)"
        },
        "--ep-tooltip-text": {
          "$ref": "#/definitions/cssValue",
          "description": "提示层文字颜色",
          "default": "var(--color-text)"
        },
        "--ep-tooltip-border": {
          "$ref": "#/definitions/cssValue",
          "description": "提示层边框；玻璃开启时缺省跟随玻璃控件边框",
          "default": "var(--color-border)"
        },
        "--ep-tooltip-radius": {
          "$ref": "#/definitions/cssValue",
          "description": "提示层圆角",
          "default": "10px"
        },
        "--ep-tooltip-shadow": {
          "$ref": "#/definitions/cssValue",
          "description": "提示层阴影；玻璃开启时缺省跟随玻璃面板阴影",
          "default": "0 6px 20px rgb(0 0 0 / 16%)"
        },
        "--ep-tooltip-font-size": {
          "$ref": "#/definitions/cssValue",
          "description": "提示层字号",
          "default": "12px"
        },
        "--ep-tooltip-padding": {
          "$ref": "#/definitions/cssValue",
          "description": "文字提示内边距",
          "default": "6px 10px"
        },
        "--ep-tooltip-max-width": {
          "$ref": "#/definitions/cssValue",
          "description": "提示层最大宽度，自动限制在视口内",
          "default": "280px"
        },
        "--ep-tooltip-control-width": {
          "$ref": "#/definitions/cssValue",
          "description": "竖向调节提示层宽度",
          "default": "40px"
        },
        "--ep-tooltip-control-height": {
          "$ref": "#/definitions/cssValue",
          "description": "竖向调节提示层高度",
          "default": "160px"
        }
      }
    },
    "rules": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "pattern": "^\\.ep-[a-z][a-z0-9-]*(?::(?:hover|focus-visible|disabled))?(?: \\.ep-[a-z][a-z0-9-]*(?::(?:hover|focus-visible|disabled))?)*$"
      },
      "additionalProperties": {
        "type": "object",
        "maxProperties": 64,
        "propertyNames": {
          "pattern": "^[a-z][a-z-]*$"
        },
        "additionalProperties": {
          "$ref": "#/definitions/cssValue"
        }
      }
    },
    "glass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectors", "blur", "refraction", "saturation"],
      "properties": {
        "selectors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\.ep-[a-z][a-z0-9-]*(?::(?:hover|focus-visible|disabled))?(?: \\.ep-[a-z][a-z0-9-]*(?::(?:hover|focus-visible|disabled))?)*$"
          }
        },
        "blur": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "refraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 40
        },
        "saturation": {
          "type": "number",
          "minimum": 1,
          "maximum": 2
        },
        "thickness": {
          "type": "number",
          "minimum": 4,
          "maximum": 64
        },
        "ior": {
          "type": "number",
          "minimum": 1,
          "maximum": 2.5
        },
        "dispersion": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fresnel": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "highlight": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "lightAngle": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "shadow": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "interactive": {
          "type": "boolean"
        }
      }
    },
    "assets": {
      "type": "object",
      "required": ["resources", "slots"],
      "additionalProperties": false,
      "properties": {
        "resources": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "object",
            "required": ["type", "path"],
            "properties": {
              "type": {
                "enum": ["font", "image"]
              },
              "path": {
                "type": "string",
                "maxLength": 160,
                "pattern": "^(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+[.][a-zA-Z0-9]+$"
              },
              "weight": {
                "type": "string",
                "pattern": "^(?:[1-9]00|[1-9]00 [1-9]00)$"
              },
              "style": {
                "enum": ["normal", "italic"]
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "font"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "path": {
                      "pattern": "\\.(?:[wW][oO][fF][fF]2?|[tT][tT][fF]|[oO][tT][fF])$",
                      "type": "string"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "path": {
                      "pattern": "\\.(?:[pP][nN][gG]|[jJ][pP][eE]?[gG]|[wW][eE][bB][pP]|[gG][iI][fF])$",
                      "type": "string"
                    }
                  }
                }
              }
            ]
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        },
        "slots": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "appBackground": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "image": {
                  "type": "string"
                }
              }
            },
            "home": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "image": {
                  "type": "string"
                },
                "font": {
                  "type": "string"
                }
              }
            },
            "sidebar": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "image": {
                  "type": "string"
                },
                "font": {
                  "type": "string"
                }
              }
            },
            "header": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "image": {
                  "type": "string"
                },
                "font": {
                  "type": "string"
                }
              }
            },
            "footer": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "image": {
                  "type": "string"
                },
                "font": {
                  "type": "string"
                }
              }
            },
            "button": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "image": {
                  "type": "string"
                },
                "font": {
                  "type": "string"
                }
              }
            },
            "dialog": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "image": {
                  "type": "string"
                },
                "font": {
                  "type": "string"
                }
              }
            },
            "drawer": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "image": {
                  "type": "string"
                },
                "font": {
                  "type": "string"
                }
              }
            },
            "menu": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "image": {
                  "type": "string"
                },
                "font": {
                  "type": "string"
                }
              }
            },
            "global": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "font": {
                  "type": "string"
                }
              }
            },
            "playbackThumb": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "image": {
                  "type": "string"
                }
              }
            }
          }
        },
        "text": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "appTitle": {
              "type": "string",
              "maxLength": 200
            },
            "homeWelcome": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "licenses": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+[.]txt$",
            "maxLength": 160
          },
          "uniqueItems": true
        }
      }
    },
    "shader": {
      "type": "object",
      "required": ["fragment", "textures"],
      "additionalProperties": false,
      "properties": {
        "fragment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+\\.glsl$"
        },
        "textures": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["uniform", "path", "width", "height", "format"],
            "additionalProperties": false,
            "properties": {
              "uniform": {
                "type": "string",
                "minLength": 1,
                "maxLength": 66,
                "pattern": "^u_[a-z][a-z0-9_]{0,63}$",
                "not": {
                  "enum": ["u_resolution", "u_time", "u_pointer"]
                }
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+\\.(?:bin|png|jpe?g|webp|gif)$"
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2048
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2048
              },
              "format": {
                "enum": ["rg32f", "image"]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "format": {
                      "const": "rg32f"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "\\.bin$"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "\\.(?:png|jpe?g|webp|gif)$"
                    }
                  }
                }
              }
            ]
          }
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      }
    },
    "renderer": {
      "type": "object",
      "required": ["entry"],
      "additionalProperties": false,
      "description": "Official catalog themes only; arbitrary third-party renderer code is rejected by the host.",
      "properties": {
        "entry": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+\\.js$"
        }
      }
    }
  },
  "definitions": {
    "color": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?:#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|rgba|hsl|hsla|oklch|oklab)\\([0-9.,% /+-]+\\))$",
      "not": {
        "pattern": "(?:[uU][rR][lL]|[vV][aA][rR]|[eE][xX][pP][rR][eE][sS][sS][iI][oO][nN]|[iI][mM][aA][gG][eE]-[sS][eE][tT]|[pP][aA][iI][nN][tT])\\s*\\("
      }
    },
    "cssValue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "allOf": [
        {
          "not": {
            "pattern": "[;{}<>@\\\\!\\u0000-\\u001f]"
          }
        },
        {
          "not": {
            "pattern": "(?:[uU][rR][lL]|[iI][mM][aA][gG][eE]-[sS][eE][tT]|[eE][xX][pP][rR][eE][sS][sS][iI][oO][nN])\\s*\\("
          }
        },
        {
          "not": {
            "pattern": "/\\*"
          }
        }
      ]
    }
  },
  "not": {
    "required": ["shader", "renderer"],
    "properties": {
      "shader": {},
      "renderer": {}
    }
  }
}
