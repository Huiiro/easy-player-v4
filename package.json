{
  "name": "easy-player",
  "version": "3.3.1",
  "description": "Easy Player V4",
  "main": "./out/main/index.js",
  "author": "huiiro",
  "homepage": "https://github.com/Huiiro",
  "repository": {
    "type": "git",
    "url": "https://github.com/Huiiro/easy-player-v4.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "npm run prepare:fpcalc && npm run build:taskbar && electron-vite dev",
    "build": "npm run build:taskbar && npm run typecheck && electron-vite build",
    "build:nocheck": "electron-vite build",
    "prepare:ytdlp": "node scripts/prepare-ytdlp.mjs",
    "prepare:fpcalc": "node scripts/prepare-fpcalc.mjs",
    "update:ytdlp": "node scripts/update-ytdlp.mjs && npm run prepare:ytdlp",
    "prepare:native": "node scripts/prepare-native-deps.mjs",
    "test:audio-core": "node scripts/test-audio-ffmpeg.mjs && node scripts/test-native-metadata.mjs",
    "test:packaging-deps": "node scripts/test-ytdlp-preparation.mjs && node scripts/test-windows-runtime.cjs",
    "build:native": "node scripts/build-native.mjs",
    "build:native:debug": "node scripts/build-native.mjs --debug",
    "postinstall": "electron-builder install-app-deps",
    "prepare:auto-mix": "node scripts/prepare-auto-mix-runtime.mjs",
    "prepare:ffmpeg": "node scripts/prepare-auto-mix-ffmpeg.mjs",
    "package:auto-mix": "npm run prepare:auto-mix && node scripts/package-auto-mix-runtime.mjs",
    "test:bundled-auto-mix": "node scripts/test-bundled-auto-mix.mjs",
    "test:auto-mix-runtime": "node scripts/test-auto-mix-runtime.mjs",
    "test:auto-mix-component-install": "node scripts/test-auto-mix-component-install.mjs",
    "build:unpack": "npm run prepare:ytdlp && npm run prepare:fpcalc && npm run build:native && npm run prepare:ffmpeg && npm run build && node scripts/package-windows.mjs --dir",
    "build:taskbar": "node scripts/build-taskbar-controls.mjs",
    "build:win": "npm run typecheck && npm run prepare:ytdlp && npm run prepare:fpcalc && npm run build:taskbar && npm run build:native && npm run prepare:ffmpeg && npm run build:nocheck && node scripts/package-windows.mjs",
    "build:mac": "node scripts/build-macos.mjs",
    "test:macos-package": "node scripts/verify-macos-package.cjs",
    "test:macos-runtime": "node scripts/test-macos-runtime.cjs",
    "build:linux": "npm run prepare:ytdlp && npm run prepare:fpcalc && npm run build:nocheck && electron-builder --linux",
    "test:ui": "electron scripts/check-ui-components.cjs",
    "test:settings-search": "node scripts/test-settings-search.mjs && electron scripts/check-settings-search.cjs",
    "test:updates": "node scripts/test-automatic-updates.mjs && electron scripts/check-automatic-updates.cjs",
    "test:list-loading": "electron scripts/check-list-loading.cjs",
    "test:song-columns": "electron scripts/check-song-columns.cjs",
    "test:footer-menu": "electron scripts/check-footer-menu.cjs",
    "test:home": "electron scripts/check-home-layout.cjs",
    "test:global-search": "electron scripts/check-global-search.cjs",
    "test:appearance": "node scripts/test-appearance.mjs && electron scripts/check-appearance.cjs",
    "test:window-material": "electron scripts/check-mica-dialog.cjs",
    "test:background-transition": "electron scripts/check-background-transition.cjs",
    "test:animation-activity": "electron scripts/check-animation-activity.cjs",
    "test:mesh-background": "electron scripts/check-mesh-background.cjs && electron scripts/check-player-panel-switch.cjs --mesh",
    "test:theme-system": "electron scripts/check-theme-system.cjs",
    "test:card-motion": "electron scripts/check-card-motion.cjs",
    "test:genres": "node scripts/test-genres.mjs",
    "test:library-auto-import": "node scripts/test-library-auto-import.mjs",
    "test:file-drop-import": "node scripts/test-file-drop-import.mjs",
    "test:library-auto-import:ui": "electron scripts/check-library-settings.cjs",
    "test:fingerprint-diagnostics": "node scripts/test-fingerprint-diagnostics.mjs",
    "test:duplicate-checking": "node scripts/test-duplicate-checking.mjs",
    "test:duplicate-task": "node scripts/test-duplicate-task.mjs",
    "test:duplicate-files": "node scripts/test-duplicate-files.mjs",
    "test:duplicate-cache": "node scripts/test-duplicate-cache.mjs",
    "test:fingerprint-matching": "node scripts/test-fingerprint-matching.mjs",
    "perf:fingerprint-matching": "node scripts/test-fingerprint-matching.mjs --benchmark",
    "perf:duplicate-fingerprint": "node scripts/test-duplicate-cache.mjs --benchmark",
    "test:native-metadata": "node scripts/test-native-metadata.mjs",
    "test:playback-mode": "node scripts/test-playback-mode.mjs",
    "test:shuffle": "node scripts/test-shuffle.mjs",
    "migrate:legacy": "node scripts/migrate-legacy-library.mjs",
    "test:legacy-migration": "node scripts/test-legacy-migration.mjs",
    "test:shortcuts": "node scripts/test-shortcuts.mjs && node scripts/test-renderer-persistence.mjs",
    "test:song-search": "node scripts/test-song-search-ui.mjs && node scripts/test-song-search.mjs",
    "test:download-audio": "node scripts/test-download-audio.mjs",
    "perf:song-search": "node scripts/benchmark-song-search.mjs",
    "perf:playback": "node scripts/check-playback-performance.cjs",
    "test:track-switch": "electron scripts/check-track-switch.cjs && electron scripts/check-player-panel-switch.cjs",
    "perf:app": "electron scripts/check-player-app.cjs",
    "test:remote-sources:ui": "electron scripts/check-remote-source-ui.cjs",
    "test:remote-sources": "node scripts/test-remote-sources.mjs && node scripts/test-file-transfer.mjs && node scripts/test-remote-source-storage.mjs",
    "test:network-sources": "node scripts/test-network-sources.mjs && node scripts/test-lyric-providers.mjs",
    "test:source-metadata": "node scripts/test-source-metadata.mjs",
    "test:source-metadata:ui": "electron scripts/check-source-metadata.cjs",
    "test:song-lyrics": "node scripts/test-song-lyrics.mjs",
    "test:lyrics-manager": "electron scripts/check-lyrics-manager.cjs",
    "test:desktop-lyrics-settings": "electron scripts/check-desktop-lyrics-settings.cjs",
    "test:lyrics-editor": "node scripts/test-lyric-editor.mjs && electron scripts/check-lyrics-editor.cjs",
    "test:builtin-plugins": "node scripts/test-builtin-plugins.mjs",
    "test:qqmusic-source": "node scripts/test-qqmusic-source.mjs",
    "test:kugou-source": "node scripts/test-kugou-source.mjs",
    "test:source-runtime": "node scripts/test-source-runtime.mjs",
    "test:source-management": "node scripts/test-source-management.mjs",
    "test:source-management:ui": "electron scripts/check-network-sources.cjs",
    "build:plugins": "node scripts/run-plugin-project.mjs run build && node scripts/sync-official-plugins.mjs",
    "test:official-plugins": "node scripts/test-official-plugins.mjs",
    "typecheck:plugins": "node scripts/run-plugin-project.mjs run typecheck",
    "test:plugin-project": "node scripts/test-plugin-project-isolation.mjs",
    "build:plugin-sdk": "npm --prefix packages/plugin-sdk run build && npm pack ./packages/plugin-sdk --pack-destination ./build --ignore-scripts",
    "test:theme-plugins": "node scripts/test-theme-plugins.mjs",
    "pack:theme": "node scripts/pack-theme.mjs",
    "pack:themes": "node scripts/package-theme-examples.mjs",
    "sync:theme-contract": "node scripts/sync-theme-contract.mjs",
    "test:theme-contract": "node scripts/sync-theme-contract.mjs --check && node scripts/test-theme-contract.mjs",
    "test:taskbar": "npm run build:taskbar && node scripts/test-taskbar-playback.mjs && node scripts/test-thumbnail-playback.mjs && node scripts/check-taskbar-strip.cjs",
    "test:taskbar-cover": "node scripts/check-taskbar-cover.cjs",
    "test:plugin-logs": "node scripts/test-plugin-logs.mjs",
    "test:plugin-proxy": "electron scripts/test-plugin-proxy.cjs && electron scripts/check-plugin-proxy-settings.cjs",
    "test:smtc": "cmake --build build/native-addon --target easy_player_smtc easy_player_smtc_probe --config Release && electron scripts/test-system-media-controls.cjs",
    "test:shutdown": "node scripts/test-application-shutdown.mjs && node scripts/test-playback-checkpoint.mjs && node scripts/test-resource-lifecycle.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@xmldom/xmldom": "^0.9.12",
    "adm-zip": "^0.6.0",
    "basic-ftp": "^6.2.3",
    "better-sqlite3": "^12.4.1",
    "electron-updater": "^6.6.2",
    "kuroshiro": "^1.2.1",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "music-metadata": "^11.14.0",
    "node-id3": "^0.2.9",
    "opencc-js": "^1.4.2",
    "pinyin-pro": "^3.29.5",
    "sharp": "^0.35.3",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@headlessui/vue": "^1.7.23",
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-vue": "^6.0.2",
    "ajv": "8.20.0",
    "cmake-js": "^8.0.0",
    "cropperjs": "^1.6.2",
    "electron": "^39.2.6",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "0.25.12",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "fast-glob": "^3.3.3",
    "gsap": "^3.15.0",
    "music-metadata-browser": "^2.5.11",
    "node-addon-api": "^8.9.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "prettier": "^3.7.4",
    "selfsigned": "^5.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue": "^3.5.25",
    "vue-eslint-parser": "^10.2.0",
    "vue-i18n": "^11.4.2",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.1.6",
    "vue-virtual-scroller": "^3.0.4",
    "vuedraggable": "^4.1.0"
  }
}
